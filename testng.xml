<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright UI Automation Test Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Smoke Tests - Chrome" parallel="false">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.automation.tests.LoginTests"/>
            <class name="com.automation.tests.RegistrationTests"/>
        </classes>
    </test>

    <test name="Regression Tests - Chrome" parallel="false">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.automation.tests.ProductTests"/>
            <class name="com.automation.tests.CartTests"/>
            <class name="com.automation.tests.CheckoutTests"/>
        </classes>
    </test>

</suite>
